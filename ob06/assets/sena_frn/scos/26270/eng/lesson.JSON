"content\\\": \\\"pourrions\\\"}\",\"{\\\"type\\\": \\\"text\\\", \\\"content\\\": \\\"vous\\\"}\",\"{\\\"type\\\": \\\"text\\\", \\\"content\\\": \\\"pourriez\\\"}\",\"{\\\"type\\\": \\\"text\\\", \\\"content\\\": \\\"ils/elles\\\"}\",\"{\\\"type\\\": \\\"text\\\", \\\"content\\\": \\\"pourraient\\\"}\"],\"styles\":\" instruction_table_background intro_table_border\"}", "type": "table"}]}]}